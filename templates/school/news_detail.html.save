{% extends 'school/base.html' %}
{% load static %}

{% block title %}{{ news.title }} - {{ school_info.name }}{% endblock %}

{% block og_title %}{{ news.title }} - {{ school_info.name }}{% endblock %}

{% block og_description %}
{{ news.content|striptags|truncatechars:160 }}
{% endblock %}

{% block og_image %}
{% if news.image %}
{{ request.scheme }}://{{ request.get_host }}{{ news.image.url }}
{% else %}
{{ request.scheme }}://{{ request.get_host }}{% static 'img/school-badge.png' %}
{% endif %}
{% endblock %}

{% block content %}
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{% url 'home' %}">Home</a></li>
                        <li class="breadcrumb-item"><a href="{% url 'news_list' %}">News</a></li>
                        <li class="breadcrumb-item active">{{ news.title }}</li>
                    </ol>
                </nav>

                <article class="card">
                    {% if news.image %}
                        <img src="{{ news.image.url }}" class="card-img-top" alt="{{ news.title }}">
                    {% endif %}
                    <div class="card-body">
                        {% if news.is_featured %}
                            <span class="badge bg-warning mb-2">Featured</span>
                        {% endif %}
                        <h1 class="card-title">{{ news.title }}</h1>
                        <div class="text-muted mb-3">
                            <i class="fas fa-calendar me-2"></i>{{ news.created_at|date:"d M" }}
                            {% if news.category %}
                            <span class="badge ms-2" style="background-color: {{ news.category.color }};">{{ news.category.name }}</span>
                            {% endif %}
                        </div>
                        <div class="card-text">
                            {{ news.content|safe }}
                        </div>
                        
                        <!-- Tags -->
                        {% if news.tags.all %}
                        <div class="mt-3 mb-3">
                            {% for tag in news.tags.all %}
                            <span class="badge bg-secondary me-1">#{{ tag.name }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                        
                        <!-- Category -->
                        {% if news.category %}
                        <div class="mb-3">
                            <span class="badge" style="background-color: {{ news.category.color }};">{{ news.category.name }}</span>
                        </div>
                        {% endif %}
                        
                        <!-- Share Buttons -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <h6 class="mb-0"><i class="fas fa-share-alt me-2"></i>Share:</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.build_absolute_uri }}" 
                                       target="_blank" 
                                       class="btn btn-sm" 
                                       style="background-color: #1877f2; border-color: #1877f2; color: white;"
                                       title="Share on Facebook">
                                        <i class="fab fa-facebook-f me-1"></i>Share
                                    </a>
                                    <a href="https://twitter.com/intent/tweet?url={{ request.build_absolute_uri }}&text={{ news.title|urlencode }}" 
                                       target="_blank" 
                                       class="btn btn-sm" 
                                       style="background-color: #1da1f2; border-color: #1da1f2; color: white;"
                                       title="Share on Twitter">
                                        <i class="fab fa-twitter me-1"></i>Share
                                    </a>
                                    <a href="https://wa.me/?text={{ news.title|urlencode }}%20{{ request.build_absolute_uri|urlencode }}" 
                                       target="_blank" 
                                       class="btn btn-sm btn-success"
                                       title="Share on WhatsApp">
                                        <i class="fab fa-whatsapp me-1"></i>Share
                                    </a>
                                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ request.build_absolute_uri }}" 
                                       target="_blank" 
                                       class="btn btn-sm" 
                                       style="background-color: #0077b5; border-color: #0077b5; color: white;"
                                       title="Share on LinkedIn">
                                        <i class="fab fa-linkedin-in me-1"></i>Share
                                    </a>
                                    <button onclick="copyToClipboard('{{ request.build_absolute_uri }}')" 
                                            class="btn btn-sm btn-secondary"
                                            title="Copy link">
                                        <i class="fas fa-link me-1"></i>Copy Link
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
                
                <script>
                function copyToClipboard(text) {
                    navigator.clipboard.writeText(text).then(function() {
                        alert('Link copied to clipboard!');
                    }, function(err) {
                        // Fallback for older browsers
                        var textArea = document.createElement("textarea");
                        textArea.value = text;
                        document.body.appendChild(textArea);
                        textArea.select();
                        document.execCommand('copy');
                        document.body.removeChild(textArea);
                        alert('Link copied to clipboard!');
                    });
                }
                </script>
            </div>

            <div class="col-lg-4">
                <!-- Related News -->
                {% if related_news %}
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-newspaper me-2"></i>Related News</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for related in related_news %}
                        <a href="{{ related.get_absolute_url }}" class="list-group-item list-group-item-action">
                            <h6>{{ related.title }}</h6>
                            <small class="text-muted">{{ related.created_at|date:"M d, Y" }}</small>
                        </a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Quick Links -->
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-link me-2"></i>Quick Links</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="{% url 'news_list' %}" class="list-group-item list-group-item-action">
                            <i class="fas fa-newspaper me-2"></i>All News
                        </a>
                        <a href="{% url 'announcements' %}" class="list-group-item list-group-item-action">
                            <i class="fas fa-bullhorn me-2"></i>Announcements
                        </a>
                        <a href="{% url 'events' %}" class="list-group-item list-group-item-action">
                            <i class="fas fa-calendar me-2"></i>Events
                        </a>
                        <a href="{% url 'contact' %}" class="list-group-item list-group-item-action">
                            <i class="fas fa-envelope me-2"></i>Contact Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

